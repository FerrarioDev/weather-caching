# Weather API Configuration
# Get your API key from: https://www.visualcrossing.com/
WEATHER_API=your_api_key_here

# Redis Configuration
# Address of Redis server (host:port)
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Server Configuration
# Port to run the server on
SERVER_PORT=:8084
